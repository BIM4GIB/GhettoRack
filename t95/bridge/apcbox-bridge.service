[Unit]
Description=ApcBox bridge (Daisy USB serial, T95 MIDI controllers, page on :8040)
After=network.target

[Service]
ExecStart=/opt/apcbox-bridge/venv/bin/python3 /opt/apcbox-bridge/apcbox_bridge.py --ui /opt/apcbox-bridge/apcbox-ui.html --selector /opt/apcbox-bridge/selector.html --hub /opt/apcbox-bridge/midihub.html --clock-page /opt/apcbox-bridge/clock.html --apcbox-page /opt/apcbox-bridge/apcbox.html
Restart=always
RestartSec=2
# Own throwaway user; dialout for the Daisy, audio for the MIDI controllers,
# input for the IR receiver. State (last module, IR buttons) in /var/lib/apcbox-bridge
DynamicUser=yes
SupplementaryGroups=dialout audio input
StateDirectory=apcbox-bridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No real-time priority: this is telemetry and web serving, not timing work

[Install]
WantedBy=multi-user.target
