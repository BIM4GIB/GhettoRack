[Unit]
Description=GhettoRack kiosk: Chromium full screen on HDMI (cage)
After=systemd-user-sessions.service apcbox-bridge.service
Wants=apcbox-bridge.service
# It takes over the HDMI console; SSH still works
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Wait for the bridge's page, then show the selector; it starts the last
# module after its countdown
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do wget -q -O /dev/null http://127.0.0.1:8040/caps && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars \
  --no-first-run --password-store=basic --disable-translate --disable-features=Translate \
  --check-for-update-interval=31536000 --ozone-platform=wayland --user-data-dir=/var/lib/kiosk/chromium \
  "http://127.0.0.1:8040/?boot=1&tv=1"
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
